{
  "name": "skillpass",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:generate": "pnpm --filter @skillpass/db generate",
    "db:push": "pnpm --filter @skillpass/db push",
    "db:migrate": "pnpm --filter @skillpass/db migrate",
    "db:seed": "pnpm --filter @skillpass/db seed",
    "db:studio": "pnpm --filter @skillpass/db studio"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
